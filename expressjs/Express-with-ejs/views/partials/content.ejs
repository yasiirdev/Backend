<section class="w-full bg-gray-50 px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-10">
  <% if (!hostData || hostData.length === 0) { %>
    <div class="mx-auto flex max-w-md flex-col items-center gap-2 py-16 text-center text-gray-500">
      <svg class="h-12 w-12 text-gray-300" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9.75 12 3l9 6.75M4.5 10.5V20a1 1 0 0 0 1 1h5v-6h3v6h5a1 1 0 0 0 1-1v-9.5" />
      </svg>
      <p class="text-lg font-semibold text-gray-700">No homes yet</p>
      <p class="text-sm">Use "Add Home" to create your first listing.</p>
    </div>

  <% } else { %>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4">
      <% hostData.forEach((i) => { %>

        <article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-900/5 transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="relative aspect-4/3 w-full overflow-hidden bg-gray-100">
            <img
              src="<%= i.image %>"
              alt="<%= i.location %>"
              loading="lazy"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
            <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-gray-900 shadow backdrop-blur">
              <svg class="h-3.5 w-3.5 fill-amber-400" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 0 0 .95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 0 0-.363 1.118l1.287 3.957c.3.922-.755 1.688-1.539 1.118l-3.37-2.448a1 1 0 0 0-1.176 0l-3.37 2.448c-.783.57-1.838-.196-1.538-1.118l1.286-3.957a1 1 0 0 0-.363-1.118l-3.37-2.448c-.782-.57-.38-1.81.588-1.81h4.163a1 1 0 0 0 .95-.69l1.285-3.958Z"/>
              </svg>
              <%= i.rating %> /100
            </span>
          </div>

          <div class="flex flex-1 flex-col gap-1.5 p-4 sm:p-5">
            <h3 class="truncate text-base font-semibold capitalize  text-gray-900 sm:text-lg">
              <%= i.location %>
            </h3>

            <div class="mt-auto flex items-center justify-between gap-2 pt-3">
              <p class="text-lg font-bold text-gray-900 sm:text-xl">
                $<%= i.perNight %>
                <span class="text-sm font-normal text-gray-500">/ night</span>
              </p>

              <a
                href="#"
                class="inline-flex items-center gap-1 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-1"
              >
                View
                <svg class="h-4 w-4 rtl:rotate-180" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/>
                </svg>
              </a>
            </div>
          </div>

        </article>

      <% }) %>
    </div>

  <% } %>

</section>
