<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 — Page Not Found</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="m-0 p-0 box-border w-full min-h-screen bg-slate-950 text-white overflow-hidden relative flex items-center justify-center">

  <!-- Animated gradient blobs -->
  <div class="pointer-events-none absolute -top-32 -left-32 w-96 h-96 bg-blue-600/30 rounded-full blur-3xl animate-pulse"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-32 w-96 h-96 bg-purple-600/30 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  <div class="pointer-events-none absolute top-1/3 right-1/4 w-72 h-72 bg-cyan-500/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

  <!-- Grid overlay for texture -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-size-[40px_40px]"></div>

  <main class="relative z-10 flex flex-col items-center justify-center text-center px-6 py-16 max-w-2xl mx-auto">

    <!-- Floating astronaut / emoji -->
    <div class="text-7xl mb-4 animate-bounce select-none" style="animation-duration: 3s;">
      🛸
    </div>

    <!-- Big 404 with glow -->
    <h1 class="text-[7rem] sm:text-[10rem] leading-none font-black tracking-tight bg-linear-to-r from-blue-400 via-cyan-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_45px_rgba(56,189,248,0.35)]">
      404
    </h1>

    <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-white">
      Houston, we have a problem.
    </h2>

    <p class="mt-4 text-slate-400 text-base sm:text-lg leading-relaxed">
      The page you're looking for drifted off into space, got renamed,
      or never existed in the first place. Let's get you back on course.
    </p>

    <!-- Search-style hint -->
    <div class="mt-6 w-full max-w-md rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm px-4 py-3 text-left text-sm text-slate-400 font-mono">
      <span class="text-red-400">GET</span> <%= typeof url !== 'undefined' ? url : 'this page' %> <span class="text-slate-600">→</span> <span class="text-yellow-400">404 Not Found</span>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
      <a href="/"
         class="group inline-flex items-center gap-2 px-6 py-3 rounded-full bg-linear-to-r from-blue-500 to-cyan-400 text-slate-950 font-semibold shadow-lg shadow-blue-500/30 hover:shadow-cyan-400/40 hover:scale-105 transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
        </svg>
        Take me home
      </a>

      <button onclick="history.back()"
         class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/15 text-slate-200 font-semibold hover:bg-white/10 hover:border-white/30 transition-all duration-300">
        Go back
      </button>
    </div>

    <p class="mt-12 text-xs text-slate-600 tracking-wide uppercase">
      Error code 404 · Lost in the void since <%= new Date().getFullYear() %>
    </p>
  </main>

</body>
</html>
